// شمای هستهٔ عملیاتی — منبع حقیقتِ حالت.
//
// منبع: specs/001-request-intake-triage/data-model.md بخش «ب»
//
// ─────────────────────────────────────────────────────────────────────────
// چرا SQLite و نه PostgreSQL (اصل VII — متناسب با مقیاس واقعی)
// ─────────────────────────────────────────────────────────────────────────
//
// حجم واقعی این سامانه ۳۰ تا ۵۰ ثبت در ماه است. حتی با افزوده شدن گزارش‌های
// آتی — بازدید، کلیک، SEO — داده‌ای که اینجا می‌نشیند **خلاصه** است نه رویداد
// خام: منبع حقیقتِ آنالیتیکس روی Firebase و GA4 است و ما فقط جمع‌بندی‌اش را
// نگه می‌داریم (همان الگوی `ReportPeriod`). جمع کل زیر ده هزار ردیف در سال.
//
// یک دیتابیس مدیریت‌شدهٔ جدا روی لیارا ۳۵۰ هزار تومان در ماه است — ۴٫۲ میلیون
// در سال برای چند مگابایت داده. همان بیش‌مهندسی‌ای که اصل VII منع کرده.
//
// **کِی باید تجدید نظر کرد** — این‌ها را عمداً اینجا می‌نویسم تا فراموش نشود:
//   • اگر روزی رویداد خام (نه خلاصه) نگه داشته شود
//   • اگر چند نفر هم‌زمان بنویسند — SQLite قفل تک‌نویسنده دارد؛ امروز یک
//     تریاژگر داریم پس مسئله نیست
//   • اگر گزارش تحلیلی با پنجرهٔ زمانی یا همبستگی لازم شود
//
// ─────────────────────────────────────────────────────────────────────────
// دو قاعدهٔ سراسری، بی‌تغییر از نسخهٔ Postgres
// ─────────────────────────────────────────────────────────────────────────
//
//   ۱. هیچ `onDelete: Cascade` — ناوردای ۹ و FR-027: هیچ رکوردی حذف نمی‌شود،
//      حتی پس از رد. رابطه‌ها روی `Restrict` می‌مانند.
//
//   ۲. تمام زمان‌ها UTC ذخیره می‌شوند. هیچ ستون تاریخ جلالی وجود ندارد —
//      تبدیل فقط در لایهٔ نمایش (R-07، ناوردای ۱۰).
//
// ─────────────────────────────────────────────────────────────────────────
// چه چیزی با مهاجرت از Postgres عوض شد
// ─────────────────────────────────────────────────────────────────────────
//
//   `enum`     → `String`. SQLite enum ندارد. **ایمنی نوع از دست نرفت**:
//                همان اتحادهای رشته‌ای در `@alfred-online/contracts` تعریف
//                شده‌اند و کد با آن‌ها کار می‌کند، نه با رشتهٔ آزاد. مقادیر
//                مجاز در کامنت هر فیلد آمده و مهاجرت `CHECK` می‌گذارد.
//   `String[]` → `String` حاوی JSON. SQLite آرایه ندارد.
//   `Json`     → SQLite پشتیبانی می‌کند و بدون تغییر ماند.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── درخواست ──────────────────────────────────────────────────────────────

model Request {
  /// `REQ-NNN` — در **لبه** صادر می‌شود، نه اینجا. هرگز تغییر نمی‌کند (FR-020، ناوردای ۳).
  id String @id

  /// `bug` | `improvement` | `idea`
  /// قابل تغییر در تریاژ **بدون** تغییر `id` (FR-021).
  type String

  /// حدس اولیهٔ ثبت‌کننده — برای سنجش نرخ دسته‌بندی اشتباه. هرگز عوض نمی‌شود.
  originalType String

  submitterId String
  submitter   Submitter @relation(fields: [submitterId], references: [id], onDelete: Restrict)

  /// `editorial` | `technical` | `commercial` | `management` | `other`
  unit String

  /// عین متن فارسی. **تغییرناپذیر پس از درج** — اصل II، ناوردای ۱، FR-024.
  /// نگهبانی‌اش در کد است (T060 → `403 IMMUTABLE`).
  rawAnswers Json

  attachments Json @default("[]")

  /// ارجاع به سرویس مخزن دانش، یا صریحاً `"unknown"` (FR-022، SC-009).
  /// فقط ارجاع، هرگز محتوا (اصل I).
  serviceRef String?

  /// `new` | `triaged` | `queued` | `in_progress` | `answered` | `closed`
  status String @default("new")

  /// `convert` | `merge` | `reject` | `need_data`
  triageOutcome String?

  mergedIntoId String?
  mergedInto   Request?  @relation("RequestMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom   Request[] @relation("RequestMerge")

  /// شناسهٔ دوم پس از ارتقا به ایدهٔ ارزیابی‌شده (FR-023).
  promotedRef String?

  /// **فقط در تریاژ تعیین می‌شود، نه توسط ثبت‌کننده.**
  isCritical Boolean @default(false)

  submittedAt DateTime
  /// مشتق از `submittedAt` و **نوع**: خرابی ۳ روز، بهبود و ایده ۷ روز.
  responseDueAt DateTime
  /// بدون مقدار داشتن این، `status` MUST NOT به `closed` برود (ناوردای ۴، FR-029).
  respondedAt DateTime?
  closedAt    DateTime?

  /// `bot` | `fast_track` | `manual`
  source String @default("bot")

  responses     Response[]
  derivedValues DerivedValue[]
  queueItem     QueueItem?
  decisions     Decision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, responseDueAt])
  @@index([submittedAt])
  @@index([serviceRef])
}

// ─── ثبت‌کننده ────────────────────────────────────────────────────────────

model Submitter {
  id String @id @default(cuid())

  /// هویت پیام‌رسان. یکتا — یک حساب تلگرام، یک ثبت‌کننده.
  chatId      String @unique
  displayName String

  /// یک بار پرسیده می‌شود و برای همیشه می‌ماند (FR-003).
  unit String

  /// `member` | `exception` | `revoked`
  accessStatus String   @default("member")
  firstSeenAt  DateTime @default(now())
  requestCount Int      @default(0)

  requests Request[]
}

// ─── پاسخ ─────────────────────────────────────────────────────────────────

model Response {
  /// `RSP-NNNN` — کلید idempotency سمت لبه.
  id String @id

  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Restrict)

  /// `convert` | `merge` | `reject` | `need_data`
  kind String
  body String

  /// هر سه وقتی `kind = reject` الزامی‌اند — FR-031، ناوردای ۵.
  /// nullable در شما، الزامی در اعتبارسنجی T056 و در قید جدول D1 لبه.
  rejectUnderstood String?
  rejectWhyNot     String?
  rejectWhenYes    String?

  /// **الزامی.** هیچ پاسخی بدون تأیید انسان ارسال نمی‌شود (اصل IV، FR-033).
  approvedBy String
  approvedAt DateTime

  handedToEdgeAt DateTime?
  /// فقط با ack لبه پر می‌شود (قرارداد bridge-api بند ۳).
  deliveredAt DateTime?

  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([deliveredAt])
}

// ─── قاعدهٔ استخراج و مقدار استخراج‌شده ───────────────────────────────────

model ExtractionRule {
  id      String @id @default(cuid())
  version Int

  /// `confidence` | `severity` | `impact`
  dimension String

  /// نگاشت پاسخ انسانی به مقدار — **داده، نه کد** (اصل II، R-11، FR-025).
  mapping Json

  effectiveFrom DateTime @default(now())
  supersededBy  String?

  @@unique([dimension, version])
  @@index([dimension, effectiveFrom])
}

model DerivedValue {
  id String @id @default(cuid())

  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Restrict)

  /// `confidence` | `severity` | `impact`
  dimension String
  value     String

  /// هر مقدار به قاعده‌ای که تولیدش کرده قابل ردیابی است (ناوردای ۲، FR-026).
  ruleVersion Int
  derivedAt   DateTime @default(now())

  overriddenBy String?

  /// جدا از `rawAnswers` و هرگز جایگزین آن نمی‌شود (اصل II).
  @@unique([requestId, dimension])
  @@index([requestId])
}

// ─── صف ظرفیت و مایلستون ──────────────────────────────────────────────────

model QueueItem {
  id String @id @default(cuid())

  requestId String  @unique
  request   Request @relation(fields: [requestId], references: [id], onDelete: Restrict)

  /// یکتا و پیوسته. صف **تک‌خطی** است (FR-036).
  position Int @unique

  /// آیتم بدون تخمین «تخمین‌نشده» علامت می‌خورد و در محاسبهٔ ظرفیت وارد نمی‌شود.
  estimateDays Int?

  startedAt   DateTime?
  completedAt DateTime?
  isFastTrack Boolean   @default(false)

  /// ناوردای ۷ — حداکثر یک آیتم هم‌زمان `in_progress`. قید سطح پایگاه داده
  /// با partial unique index در مهاجرت T089 بسته می‌شود.
  @@index([position])
}

model Milestone {
  id         String   @id @default(cuid())
  title      String
  targetDate DateTime

  /// `on_track` | `at_risk` | `done`
  /// **مشتق از وابستگی‌ها، نه دستی** (FR-038).
  status String @default("on_track")

  /// آرایهٔ JSON از شناسهٔ `QueueItem` ها. SQLite آرایهٔ بومی ندارد.
  dependsOnQueueItems String @default("[]")

  /// MUST به آیتم مسبب اشاره کند، وقتی `status = at_risk`.
  riskReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── تصمیم و جلسه ─────────────────────────────────────────────────────────

model CouncilSession {
  id     String   @id @default(cuid())
  heldAt DateTime

  /// آرایهٔ JSON. `count >= 3` — سامانه MUST NOT جلسهٔ تک‌کارتی را
  /// تشکیل‌شده ثبت کند (FR-039، ناوردای ۸). اعتبارسنجی در T082.
  cardsPresented String @default("[]")

  snapshotPath String?

  decisions Decision[]
}

model Decision {
  id String @id @default(cuid())

  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Restrict)

  /// `council` | `fast_track`
  forum String
  /// `execute` | `park` | `reject`
  outcome String

  /// الزامی وقتی `outcome = execute` — **دقیقاً یکی** (اصل V، FR-040، ناوردای ۶).
  /// nullable چون مسیر سریع بدون آن هم پذیرفته می‌شود.
  successMetric String?
  reviewDate    DateTime?

  /// چه چیزی از صف عقب افتاد. همیشه ثبت می‌شود، حتی خالی (FR-037).
  displaced Json @default("[]")

  /// `true` یعنی مسیر سریعی که هنوز سه فیلدش کامل نشده. **اجرا را مسدود
  /// نمی‌کند** — فقط پس از ۴۸ ساعت در هشدارها ظاهر می‌شود (FR-042، FR-043).
  incomplete Boolean @default(false)

  decidedAt DateTime @default(now())
  decidedBy String

  /// `worked` | `did_not_work` | `inconclusive`
  reviewOutcome String?
  reviewedAt    DateTime?

  sessionId String?
  session   CouncilSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@index([forum, decidedAt])
  @@index([incomplete, decidedAt])
  @@index([reviewDate])
}

// ─── سابقه و گزارش ────────────────────────────────────────────────────────

model AuditEntry {
  id String @id @default(cuid())

  entity   String
  entityId String
  field    String
  oldValue String?
  newValue String?
  actor    String
  at       DateTime @default(now())

  @@index([entity, entityId])
  @@index([at])
}

/**
 * دورهٔ گزارش — و **الگوی نگه‌داشتن خلاصه به‌جای رویداد خام**.
 *
 * وقتی گزارش‌های بازدید، کلیک و SEO اضافه شوند، همین شکل را می‌گیرند: یک
 * ردیف به‌ازای هر دوره با اعداد جمع‌بندی‌شده. منبع حقیقتشان Firebase و GA4
 * می‌ماند؛ ما فقط چیزی را نگه می‌داریم که مدیر در جلسه می‌پرسد.
 */
model ReportPeriod {
  id   String   @id @default(cuid())
  from DateTime
  to   DateTime

  submittedCount Int
  evaluatedCount Int
  executedCount  Int

  avgResponseDays Float
  slaBreaches     Int
  unitDiversity   Int
  fastTrackShare  Float

  /// نرخ موفقیت به تفکیک مرجع (FR-044، SC-006).
  successRateByForum Json

  generatedAt DateTime @default(now())

  @@unique([from, to])
}
